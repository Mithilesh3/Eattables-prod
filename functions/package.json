{
  "name": "@eattables/functions",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Functions — the only place privileged business logic runs.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "npm run build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "@eattables/shared": "*",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
