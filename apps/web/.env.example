# =============================================================================
# apps/web — browser environment
#
# Copy to .env.local (git-ignored) and fill in.
#
# EVERY variable here is NEXT_PUBLIC_* and is shipped to the browser. The Firebase
# web config is an identifier, not a secret: access is controlled by Security Rules
# and App Check. Publishing these values is expected and safe.
#
# NEVER add to this file, or to any file under apps/web:
#   - a service-account key or any part of one
#   - a payment gateway SECRET key or webhook signing secret
#   - an SMS/email provider API key
# Those belong in Google Secret Manager and are read only by Cloud Functions.
# CI fails the build if a non-NEXT_PUBLIC_ variable is referenced from apps/web/src.
# =============================================================================

# --- Firebase web config -----------------------------------------------------
# From Firebase console > Project settings > Your apps > Web app.
# No Firebase project exists yet (Phase 1). For emulator-only work these may be
# placeholder strings, but they must be non-empty.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Local development -------------------------------------------------------
# Routes the client SDK at the Firebase Emulator Suite instead of a real project.
# Keep this true for all local work until a dev project is created.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1

# --- App Check (Phase 4+, required before taking real payments) ---------------
# The reCAPTCHA *site* key is public by design. The secret key is not used here.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
